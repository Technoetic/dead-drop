                "op": "ref",
                "id": "helper-a"
              },
              {
                "op": "const",
                "value": ":cache"
              }
            ]
          }
        },
        {
          "id": "helper-c",
          "label": "이전 진입 헬퍼",
          "description": "이 헬퍼 연결을 호출하는 진입점은 없습니다.",
          "code": "const helperC = () => helperB();",
          "expr": {
            "op": "ref",
            "id": "helper-b"
          }
        }
      ],
      "scenarios": [
