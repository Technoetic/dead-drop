            },
            "no": {
              "op": "ref",
              "id": "standard"
            }
          }
        },
        {
          "id": "dust",
          "label": "잊힌 라벨",
          "description": "어디서도 읽지 않는 라벨입니다.",
          "code": "const dust = \"retired\";",
          "expr": {
            "op": "const",
            "value": "retired"
          }
        }
      ],
      "scenarios": [
        {
